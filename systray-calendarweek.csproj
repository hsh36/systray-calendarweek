<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>calendarweek</AssemblyName>
    <RootNamespace>SystrayCalendarWeek</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Resources\calendar-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Damit SystemInformation.SmallIconSize der echten DPI folgt und das
         Tray-Icon auf skalierten Displays scharf bleibt. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Systray Calendar Week</Product>
    <AssemblyTitle>Systray Calendar Week</AssemblyTitle>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Publish: framework-dependent single file, keeps the exe well under 1 MB -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
